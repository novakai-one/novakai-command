{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    // noEmit-only project: it typechecks the server AND the sibling package
    // sources it composes (agents/messaging/shell/transcript ship TS), so no
    // rootDir — those files legitimately live outside packages/server.
    "noEmit": true,
    "strict": true,
    "declaration": false,
    "sourceMap": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["contract/**/*.ts", "core/**/*.ts", "cli/**/*.ts", "tests/**/*.ts"]
}
