<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.novakai.slackbridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>scripts/nvk-slack-bridge.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/christopherdasca/Programming/Novakai-Command</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NVK_SLACK_BRIDGE_APP_BASE</key>
    <string>http://localhost:3030</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/nvk-slack-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/nvk-slack-bridge.log</string>
</dict>
</plist>
