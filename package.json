{
  "name": "novakai-command",
  "version": "1.0.0",
  "description": "Local AI Multi-Agent Operations Command Center",
  "type": "module",
  "bin": {
    "nvk": "./scripts/nvk.mjs"
  },
  "scripts": {
    "prototype:messaging": "python3 -m http.server 3040 --bind 127.0.0.1 --directory docs",
    "lint": "node tools/gates/standards.mjs",
    "messaging:test": "npm --prefix packages/messaging test && node packages/messaging/contract/check-map-drift.mjs",
    "test:fast": "npm --prefix packages/shell run test:fast && for p in packages/*; do [ \"$p\" = \"packages/shell\" ] && continue; node tools/test-fast.mjs \"$p\" || exit 1; done",
    "test:guards": "for p in packages/*; do [ \"$p\" = \"packages/shell\" ] && continue; node tools/test-fast.mjs \"$p\" --guards || exit 1; done; npm --prefix packages/shell run test:contrast",
    "test:full": "for p in packages/*; do (cd \"$p\" && npm test) || exit 1; done",
    "app": "electron desktop",
    "app:build": "electron-builder --mac --config electron-builder.yml",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^0.395.0",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.6.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.63.0"
  }
}
